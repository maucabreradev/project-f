---
// Home page - minimal forum identity + board structure
import BaseLayout from "../layouts/BaseLayout.astro";
import { app } from "../entrypoint";

interface ForumConfig {
  name: string;
  domain: string | null;
  cover_image: string | null;
  colors: {
    primary: string;
    secondary: string;
    accent: string;
    background: string;
    text: string;
  };
  registration_mode: "open" | "approval";
  require_email_confirmation: boolean;
  refund_window_minutes: number;
  sell_fraction: number;
  soft_delete_days: number;
  sheet_fields: any[];
  default_permissions: Record<string, { read: boolean; write: boolean }>;
  ai_evaluation_enabled: boolean;
  ai_criteria: string | null;
  updated_at: number;
}

const response = await app.request("/api/config");
const config = (await response.json()) as ForumConfig;
---

<BaseLayout title={config.name || "Project F Forum"}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white">{config.name || "Project F Forum"}</h1>
      <p class="mt-2 text-lg text-gray-600 dark:text-gray-400">
        A deployable web application for building customizable online roleplay forums.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Board Structure</h2>
      <div class="space-y-4">
        <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800">
          <h3 class="font-medium text-gray-900 dark:text-white">Category 1</h3>
          <ul class="mt-2 ml-4 space-y-1">
            <li class="text-gray-600 dark:text-gray-400">→ Forum 1.1</li>
            <li class="text-gray-600 dark:text-gray-400">→ Forum 1.2</li>
          </ul>
        </div>
        <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800">
          <h3 class="font-medium text-gray-900 dark:text-white">Category 2</h3>
          <ul class="mt-2 ml-4 space-y-1">
            <li class="text-gray-600 dark:text-gray-400">→ Forum 2.1</li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Recent Activity</h2>
      <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800">
        <p class="text-gray-600 dark:text-gray-400">No recent activity yet. Create your first character to get started!</p>
      </div>
    </section>
  </main>
</BaseLayout>