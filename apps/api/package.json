{
  "name": "@project-f/api",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@project-f/validation": "workspace:*",
    "argon2": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "resend": "^3.2.0",
    "ulid": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024000.0",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "wrangler": "^3.30.0"
  }
}